# Только локальная разработка. Не используйте эти значения в production.
POSTGRES_DB=kgta_alert
POSTGRES_USER=kgta_alert
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
ConnectionStrings__Watcher=Host=localhost;Port=5432;Database=kgta_alert;Username=kgta_alert;Password=change-me-for-local-development
Authentication__Google__Enabled=false
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Будущие сервисы должны читать настройки через окружение, а не из исходного кода.
ASPNETCORE_ENVIRONMENT=Development

# У production ці значення передає зовнішнє сховище секретів; не зберігайте їх у .env.
DATAPROTECTION_CERTIFICATE_PATH=
DATAPROTECTION_CERTIFICATE_PASSWORD=
